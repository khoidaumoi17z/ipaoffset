name: Build iOS Offset Desk IPA

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: macos-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Extract source archive
        shell: bash
        run: |
          test -f iOS-Offset-Desk-iPhone-Source.zip
          mkdir -p ios-build-source
          unzip -q iOS-Offset-Desk-iPhone-Source.zip -d ios-build-source
          test -f ios-build-source/iOSOffsetDesk/project.yml

      - name: Install XcodeGen
        shell: bash
        run: brew install xcodegen

      - name: Generate Xcode project
        shell: bash
        run: |
          cd ios-build-source/iOSOffsetDesk
          xcodegen generate --spec project.yml

      - name: Build ARM64 device application
        shell: bash
        run: |
          cd ios-build-source/iOSOffsetDesk
          xcodebuild \
            -project iOSOffsetDesk.xcodeproj \
            -scheme iOSOffsetDesk \
            -configuration Release \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -derivedDataPath "$RUNNER_TEMP/offsetdesk-derived" \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            ARCHS=arm64 \
            build

      - name: Verify app and package unsigned IPA
        shell: bash
        run: |
          APP_PATH="$RUNNER_TEMP/offsetdesk-derived/Build/Products/Release-iphoneos/iOSOffsetDesk.app"
          test -f "$APP_PATH/iOSOffsetDesk"
          test -f "$APP_PATH/Web/index.html"
          test -f "$APP_PATH/Web/core.js"
          test -f "$APP_PATH/Web/ios-bridge.js"
          file "$APP_PATH/iOSOffsetDesk"
          mkdir -p "$RUNNER_TEMP/offsetdesk-package/Payload"
          cp -R "$APP_PATH" "$RUNNER_TEMP/offsetdesk-package/Payload/"
          cd "$RUNNER_TEMP/offsetdesk-package"
          /usr/bin/zip -q -r "$GITHUB_WORKSPACE/iOS-Offset-Desk-unsigned.ipa" Payload
          /usr/bin/unzip -t "$GITHUB_WORKSPACE/iOS-Offset-Desk-unsigned.ipa"

      - name: Upload IPA and build instructions
        uses: actions/upload-artifact@v4
        with:
          name: iOS-Offset-Desk-unsigned-IPA
          path: |
            iOS-Offset-Desk-unsigned.ipa
            ios-build-source/iOSOffsetDesk/HUONG-DAN-IPHONE.md
          if-no-files-found: error
          retention-days: 14
